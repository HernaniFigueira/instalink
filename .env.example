# ── Banco ─────────────────────────────────────────────
# Vazio = JSON local (data/instalink.db.json), ideal p/ dev.
# Preenchido = Postgres (produção na Vercel). Obtenha em:
# Vercel Storage → Postgres, ou Neon (neon.tech), ou Supabase.
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# Descomente se o Postgres for local SEM ssl:
# PGSSLMODE=disable

# ── Login com Google (opcional) ───────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
