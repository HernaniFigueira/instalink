# Infrastructure ONLY. Copy/generate .env ON THE AUTHORIZED SERVER, mode 0600.
# This file has no usable defaults for secrets. Never commit .env or print config.
EVOLUTION_HOST=evolution.example.invalid
SERVER_URL=https://evolution.example.invalid
ACME_EMAIL=operator@example.invalid

# Independent cryptographically random secrets, 32 bytes encoded as 64 hex chars.
# Use the generation procedure in README.md; blank values fail Compose validation.
AUTHENTICATION_API_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Real Evolution 2.3.7 settings are fixed in docker-compose.yml:
# DATABASE_PROVIDER=postgresql
# DATABASE_CONNECTION_URI is derived from POSTGRES_PASSWORD, host postgres:5432,
#   database evolution, user evolution. NEVER point this at InstaLink's Neon DB.
# DATABASE_CONNECTION_CLIENT_NAME=instalink_evolution
# CACHE_REDIS_ENABLED=true
# CACHE_REDIS_URI is derived from REDIS_PASSWORD, host redis:6379, DB 0.
# CACHE_REDIS_PREFIX_KEY=instalink_evolution
# CACHE_LOCAL_ENABLED=false
# DATABASE_ENABLED is not read by 2.3.7; it is intentionally not a fake toggle.
# SERVER_DISABLE_MANAGER=true
# AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
# Extra integrations/telemetry/global webhook are disabled in Compose.

# InstaLink-only envs go in Vercel Preview scoped to arena/01a0bc51-instalink,
# NOT in Evolution's container. README generates a separate ignored transfer file:
# EVOLUTION_API_URL = SERVER_URL above
# EVOLUTION_API_KEY = AUTHENTICATION_API_KEY above
# EVOLUTION_WEBHOOK_SECRET = a FOURTH independent 32-byte random secret
# EVOLUTION_WEBHOOK_URL = https://AUTHORIZED-STAGING/api/whatsapp/providers/evolution/webhook
