{
  "name": "instalink",
  "version": "1.0.0",
  "private": true,
  "description": "InstaLink.app — Página, agenda e relacionamento para negócios de atendimento. SaaS multi-tenant",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "retention": "node scripts/retention.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ux": "node scripts/smoke-ux.mjs",
    "smoke:p3": "node scripts/smoke-p3.mjs",
    "master": "node scripts/master.mjs",
    "smoke:p4": "node scripts/smoke-p4.mjs",
    "smoke:agendar": "node scripts/smoke-agendar.mjs",
    "e2e-merchant": "node scripts/e2e-merchant.mjs",
    "test:d1a:browser": "playwright test --config tests/d1a/playwright.config.ts",
    "test:d1a:serve": "vite --config tests/d1a/vite.config.ts",
    "test:360:setup": "node tests/360/setup.mjs",
    "test:360:browser": "playwright test --config tests/360/playwright.config.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "geist": "^1.7.2",
    "next": "^14.2.35",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.17"
  }
}
