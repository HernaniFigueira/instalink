{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../src/*"],
      "@schedule-x/calendar": ["./schedule-x/node_modules/@schedule-x/calendar"],
      "@schedule-x/react": ["./schedule-x/node_modules/@schedule-x/react"],
      "@schedule-x/shared": ["./schedule-x/node_modules/@schedule-x/shared"],
      "@schedule-x/theme-default": ["./schedule-x/node_modules/@schedule-x/theme-default"],
      "@agenda-sx/temporal": ["./schedule-x/node_modules/temporal-polyfill"],
      "@agenda-sx/temporal/*": ["./schedule-x/node_modules/temporal-polyfill/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "schedule-x/node_modules"]
}
